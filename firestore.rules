rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // DEVELOPMENT / DEMO RULES — allow full read + write.
    // This is what makes the app sync with Firestore without authentication.
    // IMPORTANT: For production, replace with authenticated/role-based rules.
    //   e.g.  allow read, write: if request.auth != null;
    //   and enable the Anonymous sign-in provider (Authentication > Sign in method > Anonymous).
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
