rules_version = '2';

// SI WorkLog — assigned-site access model.
// Each form is its own document owned by the employee who created it. Employees
// can read all forms inside their assigned sites; admins see everything. Sites,
// categories and the ARC rate card are readable by allowed users (site-scoped
// for sites/forms) but writable only by admins.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasEmail() {
      return isSignedIn() && request.auth.token.email != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    // The signed-in user's own allowlist entry. Doc ids in `app_users` are the
    // lowercased email (exactly how the app writes them via normEmail()).
    // Map.get with a default avoids an error when the role field is missing.
    function myRole() {
      return get(/databases/$(database)/documents/app_users/$(myEmail()))
        .data.get('role', 'user');
    }

    function isAllowlisted() {
      return hasEmail() &&
        exists(/databases/$(database)/documents/app_users/$(myEmail()));
    }

    function isAdmin() {
      return isAllowlisted() && myRole() == 'admin';
    }

    function isAdminViewer() {
      return isAllowlisted() && myRole() == 'admin_viewer';
    }

    // Any employee on the allowlist (an admin is allowlisted too).
    function isAllowed() {
      return isAllowlisted();
    }

    function myAssignedSites() {
      return get(/databases/$(database)/documents/app_users/$(myEmail()))
        .data.get('assignedSiteIds', []);
    }

    function hasSiteAccess(siteId) {
      return myAssignedSites().hasAny([siteId]);
    }

    // --- Forms: assigned-site read; owner-only edit/delete -------------------
    match /forms/{formId} {
      allow read: if isAdmin() || isAdminViewer() ||
        (isAllowed() && hasSiteAccess(resource.data.siteId));
      // A user may only create forms they own; admins may create for anyone.
      allow create: if isAdmin() ||
        (isAllowed() &&
          request.resource.data.ownerEmail == myEmail() &&
          hasSiteAccess(request.resource.data.siteId));
      allow update: if hasEmail() &&
        resource.data.ownerEmail == myEmail() &&
        request.resource.data.ownerEmail == resource.data.ownerEmail &&
        request.resource.data.siteId == resource.data.siteId &&
        hasSiteAccess(resource.data.siteId);
      allow delete: if hasEmail() &&
        resource.data.ownerEmail == myEmail() &&
        hasSiteAccess(resource.data.siteId);
    }

    // --- Sites & categories: allowed read, admin write ------------------
    match /sites/{siteId} {
      allow read: if isAdmin() || isAdminViewer() ||
        (isAllowed() && hasSiteAccess(siteId));
      allow write: if isAdmin();
    }
    match /categories/{categoryId} {
      allow read: if isAllowed() || isAdminViewer();
      allow write: if isAdmin();
    }

    // --- ARC rate card: allowed read, admin write ----------------------
    match /arc/{arcId} {
      allow read: if isAllowed() || isAdminViewer();
      allow write: if isAdmin();
    }

    // --- Legacy `jobs` collection: admin read-only, for back up & migration --.
    // The old single-document-per-job model is retired in the UI, but its data is
    // kept intact as a safety net and to migrate into `forms`.
    match /jobs/{jobId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // --- Sheet-number counters: one shared sequence per site+cat+month --------
    // Employees can only read their OWN forms, so a shared counter document is
    // the only place every user can see — and extend — the same sequence. An
    // employee may only move a counter FORWARD (never rewind a sequence, and a
    // brand-new counter may not start below 1); admins may seed/reset it from
    // Admin → Data Tools.
    match /form_counters/{counterId} {
      allow read: if isAdmin() || isAdminViewer() ||
        (isAllowed() && hasSiteAccess(resource.data.siteId));
      allow create, update: if isAllowed() &&
        hasSiteAccess(request.resource.data.siteId) &&
        request.resource.data.lastSheetNo >=
        (resource == null ? 1 : resource.data.lastSheetNo);
      allow create, update, delete: if isAdmin();
    }

    // --- Allowlist: a user reads only their own doc; admin manages all --
    match /app_users/{email} {
      allow read: if isAdmin() || (hasEmail() && email == myEmail());
      allow write: if isAdmin();
    }

    // --- Schema/meta marker: signed-in read, admin write ---------------
    match /app_meta/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
